+// Broker rejects malformed Unicode before forwarding; reject it here too,
+// before an operation record exists, so the refusal cannot become an
+// unknown outcome.
+const MALFORMED_UNICODE = /\p{Cs}/u;
+function wellFormed(value: unknown): boolean {
+  if (typeof value === "string") return !MALFORMED_UNICODE.test(value);
+  if (value && typeof value === "object")
+    return Object.entries(value).every(
+      ([key, item]) => !MALFORMED_UNICODE.test(key) && wellFormed(item),
+    );
+  return true;
+}
