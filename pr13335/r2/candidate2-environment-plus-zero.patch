+    @Test
+    @ExtendWith(OutputCaptureExtension.class)
+    void theWrittenShapeSweepMatchesTheBinderAndLeavesOtherKeysAlone(
+            CapturedOutput output) {
+        // The binder accepts a leading '+', so the sweep must too.
+        new ApplicationContextRunner()
+                .withPropertyValues(
+                        "qwen.managed-agent.harness.turn-deadline=+600000")
+                .withUserConfiguration(PropertiesConfiguration.class)
+                .run(started -> {
+                    assertThat(started).hasNotFailed();
+                    assertThat(output).contains(
+                            "qwen.managed-agent.harness.turn-deadline=+600000");
+                });
+        // A bare 0 meant the same before and after the unit flip.
+        new ApplicationContextRunner()
+                .withPropertyValues(
+                        "qwen.managed-agent.artifacts.read-revalidation-interval=0")
+                .withUserConfiguration(PropertiesConfiguration.class)
+                .run(started -> {
+                    assertThat(started).hasNotFailed();
+                    assertThat(output).doesNotContain(
+                            "qwen.managed-agent.artifacts.read-revalidation-interval");
+                });
+        // Reading the Environment must not turn an unrelated key under the
