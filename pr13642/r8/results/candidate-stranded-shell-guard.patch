+            statement.setQueryTimeout(10);
+            statement.setString(1, binding.getBindingId());
+            try (var rows = statement.executeQuery()) {
+                while (rows.next()) {
+                    sessions.add(rows.getString(1));
+                }
+            }
+        }
+        for (String sessionId : sessions) {
+            if (exists(connection, "SELECT 1 FROM qwen_managed_session_extension_record WHERE session_scope_key = ?"
+                    + " AND CAST(tenant_id AS BINARY(2048)) = CAST(? AS BINARY(2048))"
+                    + " AND CAST(session_id AS BINARY(2048)) = CAST(? AS BINARY(2048))"
+                    + " AND CAST(domain AS BINARY(2048)) = CAST('child_run' AS BINARY(2048))"
+                    + " AND settled_at IS NULL LIMIT 1",
+                    ManagedSessionStore.sessionScopeKey(tenantId, sessionId), tenantId, sessionId)) {
+                return true;
+            }
+        }
+        return false;
