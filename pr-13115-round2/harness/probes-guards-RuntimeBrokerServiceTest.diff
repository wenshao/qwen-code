+    /** Clock advances inside finishLostRecovery, like a slow final JDBC transaction. */
+    private static final class ProbeSlowFinishRepository
+            extends StaleBindingRepository {
+        private final MutableClock clock;
+
+        ProbeSlowFinishRepository(MutableClock clock) {
+            super(clock);
+            this.clock = clock;
+        }
+
+        @Override
+        public RuntimeBindingRecord finishLostRecovery(
+                RuntimeSessionRepository sessions,
+                ToolExecutionRepository executions,
+                RuntimeBindingRecord expected) {
+            clock.advance(Duration.ofMillis(1200));
+            return super.finishLostRecovery(sessions, executions, expected);
+        }
+    }
