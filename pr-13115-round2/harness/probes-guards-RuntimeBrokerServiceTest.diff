+    /** Test-supervisor provisioner whose reconcile/recoverResources are pluggable. */
+    private static RuntimeProvisioner probeProvisioner(
+            java.util.function.Supplier<CompletionStage<RuntimeObservation>> reconcile,
+            java.util.function.Function<RuntimeBindingRecord, CompletionStage<Void>> recover) {
+        return new RuntimeProvisioner() {
+            @Override
+            public String kind() {
+                return "test-supervisor";
+            }
+
+            @Override
+            public CompletionStage<RuntimeLease> provision(
+                    RuntimeProvisionRequest request) {
+                throw new AssertionError("must not reprovision");
+            }
+
+            @Override
+            public CompletionStage<RuntimeObservation> reconcile(
+                    RuntimeProvisionRequest request,
+                    RuntimeProvisionSeed seed, RuntimeResourceHandle handle,
+                    RuntimeLease lease) {
+                return reconcile == null
+                        ? RuntimeProvisioner.super.reconcile(request, seed, handle, lease)
+                        : reconcile.get();
+            }
+
+            @Override
+            public CompletionStage<Void> recoverResources(
+                    RuntimeBindingRecord binding) {
+                return recover == null
+                        ? CompletableFuture.completedFuture(null)
+                        : recover.apply(binding);
+            }
+
+            @Override
+            public boolean supportsStartupRecovery(
+                    RuntimeResourceHandle handle) {
+                return true;
+            }
+        };
+    }
