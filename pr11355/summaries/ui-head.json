{
  "arm": "head",
  "dwsFields": [
    "profile:string",
    "groupPolicy:enum=pairing",
    "dmPolicy:enum=open",
    "senderPolicy:enum=pairing",
    "allowedUsers:string-list",
    "watchTodos:boolean",
    "startReaction:string=🤔",
    "endReaction:string",
    "sessionScope:enum=chat_thread",
    "multiSession:boolean",
    "instructions:string"
  ],
  "steps": [
    {
      "name": "create-dialog-initial",
      "Sender policy": "Pairing",
      "Direct message access": "Open",
      "Group policy": "Pairing",
      "Watch Native Todos": ""
    },
    {
      "name": "create-dialog-before-save",
      "hasDmAccess": true,
      "Sender policy": "Open",
      "Direct message access": "Disabled",
      "Group policy": "Open",
      "Watch Native Todos": ""
    },
    {
      "name": "settings-after-create",
      "channel": {
        "type": "dws",
        "groupPolicy": "open",
        "dmPolicy": "disabled",
        "senderPolicy": "open",
        "watchTodos": false,
        "sessionScope": "chat_thread",
        "multiSession": false
      }
    },
    {
      "name": "reopen-group-only",
      "Sender policy": "Open",
      "Direct message access": "Disabled",
      "Group policy": "Open",
      "Watch Native Todos": ""
    },
    {
      "name": "legacy-open",
      "Sender policy": "Open",
      "Direct message access": "Open",
      "Group policy": "Open",
      "Watch Native Todos": ""
    },
    {
      "name": "settings-after-legacy-save",
      "channel": {
        "type": "dws",
        "profile": "probe-profile",
        "senderPolicy": "open",
        "groupPolicy": "open",
        "watchTodos": false,
        "dmPolicy": "open",
        "sessionScope": "chat_thread",
        "multiSession": false
      }
    },
    {
      "name": "zh-dialog",
      "has私聊访问": true,
      "has发送者策略": true,
      "has群聊": true
    }
  ],
  "wsSettings": {
    "channels": {
      "dws-legacy": {
        "type": "dws",
        "profile": "probe-profile",
        "senderPolicy": "open",
        "groupPolicy": "open",
        "watchTodos": false,
        "dmPolicy": "open",
        "sessionScope": "chat_thread",
        "multiSession": false
      },
      "dws-group-only": {
        "type": "dws",
        "groupPolicy": "open",
        "dmPolicy": "disabled",
        "senderPolicy": "open",
        "watchTodos": false,
        "sessionScope": "chat_thread",
        "multiSession": false
      }
    },
    "$version": 4
  }
}
