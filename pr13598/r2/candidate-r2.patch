+/**
+ * The Broker admits only path-safe Runtime Session ids, while a wake turn's
+ * id is an input id (`arun_…:input`, `<monitor>:notify:<n>`): such an id is
+ * mapped to a stable path-safe digest instead of being refused at acquire.
+ */
+export function hostedRuntimeSessionId(promptId: string): string {
+  return /^[A-Za-z0-9._-]{1,512}$/.test(promptId) &&
+    promptId !== '.' &&
+    !promptId.includes('..')
+    ? promptId
+    : `wake-${createHash('sha256').update(promptId).digest('hex')}`;
+}
