+    // Spring's own 405, 406 and 415 keep their status; the catch-all below
+    // would answer 500 and log a stack trace for a client error.
+    @ExceptionHandler({HttpRequestMethodNotSupportedException.class,
+            HttpMediaTypeException.class})
+    public ResponseEntity<Map<String, Object>> protocol(Exception error,
+            HttpServletRequest request) {
+        ErrorResponse details = (ErrorResponse) error;
+        HttpStatus status = HttpStatus.valueOf(
+                details.getStatusCode().value());
+        return ResponseEntity.status(status).headers(details.getHeaders())
+                .contentType(MediaType.APPLICATION_JSON)
+                .body(envelope(request, status.name().toLowerCase(),
+                        "The request method or media type is not supported."));
+    }
+
