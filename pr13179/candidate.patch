+it('rejects relative reads that resolve outside the workspace, through .. or a link', async () => {
+  // Reads never pass Hosted file history, so this check is their only guard.
+  await writeFile(path.join(root, 'outside'), 'outside-secret');
+  await symlink(root, path.join(workspace, 'link'));
+  await writeFile(path.join(workspace, 'inside'), 'inside');
+  const runtime = randomUUID();
+  const executor = new ManagedToolExecutor(async () =>
+    createManagedToolSet(workspace, runtime),
+  );
+  const reference = (callId: string) => ({
+    sessionId: runtime,
+    promptId: randomUUID(),
+    callId,
+    argsDigest: 'digest',
+  });
+  for (const file_path of ['../outside', 'link/outside']) {
+    const result = await executor.execute(
+      reference(randomUUID()),
+      'read_file',
+      {
+        file_path,
+      },
+    );
+    expect(result).toMatchObject({
+      executionStatus: 'error',
+      error: {
+        message: expect.stringContaining(
+          'not within any of the registered workspace directories',
+        ),
+      },
+    });
+    expect(JSON.stringify(result)).not.toContain('outside-secret');
+  }
+  expect(
+    JSON.stringify(
+      await executor.execute(reference(randomUUID()), 'read_file', {
+        file_path: 'inside',
+      }),
+    ),
+  ).toContain('inside');
+});
