+  it('does not resurrect a keep-alive-expired verdict when the healthy stream later drops', async () => {
+    // One 404 on a reconnect; the next connection answers with keep-alives
+    // and clears it; much later that long-lived connection drops with a
+    // network error. The 404 was refuted long ago and must not come back.
+    vi.useFakeTimers();
+    const restoreBackoff = deterministicBackoff();
+    try {
+      let calls = 0;
+      const provider = {
+        getSession: vi.fn().mockResolvedValue({ sessionId: 'session-1' }),
+        getTranscript: vi.fn().mockResolvedValue(transcript(1)),
+        subscribeEvents: vi.fn(async function* (
+          _sessionId: string,
+          request: { signal?: AbortSignal; onAlive?: () => void },
+        ) {
+          calls++;
+          if (calls === 1)
+            throw Object.assign(new Error('session gone'), { status: 404 });
+          if (calls === 2) {
+            await new Promise((resolve) => setTimeout(resolve, 5_000));
+            request.onAlive?.();
+            await new Promise((resolve) => setTimeout(resolve, 60_000));
+            throw new TypeError('network error');
+          }
+          yield* [];
+          await new Promise((resolve) =>
+            request.signal?.addEventListener('abort', resolve),
+          );
+        }),
+      } as unknown as ManagedAgentProvider;
+      mountReact(<Probe provider={provider} />);
+      await flushReact();
+      expect(latest?.stoppedReason).toBe('session gone');
+      await act(async () => {
+        await vi.advanceTimersByTimeAsync(9_000);
+      });
+      // The keep-alive at t=8000 refuted the verdict.
+      expect(latest?.stoppedReason).toBeUndefined();
+      await act(async () => {
+        await vi.advanceTimersByTimeAsync(60_000);
+      });
+      // The drop at t=68000 is a fresh, transient failure only.
+      expect(latest?.stoppedReason).toBeUndefined();
+      expect(latest?.error).toBe('network error');
+    } finally {
+      restoreBackoff();
+      vi.useRealTimers();
+    }
+  });
