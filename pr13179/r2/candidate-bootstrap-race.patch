+  it('stops the bootstrap on a definite session answer even when the transcript leg rejects first', async () => {
+    // A deleted or unknown Session answers 404 on both legs; which rejection
+    // reaches the snapshot first must not decide whether the bootstrap stops.
+    vi.useFakeTimers();
+    try {
+      const getSession = vi.fn(
+        () =>
+          new Promise((_, reject) =>
+            setTimeout(
+              () =>
+                reject(
+                  Object.assign(new Error('session gone'), { status: 404 }),
+                ),
+              10,
+            ),
+          ),
+      );
+      const getTranscript = vi
+        .fn()
+        .mockRejectedValue(
+          Object.assign(new Error('transcript gone'), { status: 404 }),
+        );
+      const provider = {
+        getSession,
+        getTranscript,
+        subscribeEvents: vi.fn(),
+      } as unknown as ManagedAgentProvider;
+      mountReact(<Probe provider={provider} />);
+      await act(async () => {
+        await vi.advanceTimersByTimeAsync(120_000);
+      });
+      expect(getTranscript).toHaveBeenCalledTimes(1);
+      expect(latest?.stoppedReason).toBe('session gone');
+    } finally {
+      vi.useRealTimers();
+    }
+  });
+
