{
 "name": "cand-approval-20s-b",
 "arm": "cand",
 "springArgs": [
  "--qwen.managed-agent.harness.turn-deadline=20s"
 ],
 "springEnv": {
  "QWEN_MANAGED_AGENT_APPROVAL_MODE": "default",
  "QWEN_MANAGED_AGENT_APPROVAL_TIMEOUT": "90s"
 },
 "prompt": "[WRITE] write the probe file",
 "windowMs": 62000,
 "steps": [
  {
   "at": 12000,
   "do": "actions"
  },
  {
   "at": 12500,
   "do": "actionGet"
  },
  {
   "at": 30000,
   "do": "actionGet"
  },
  {
   "at": 31000,
   "do": "respond",
   "option": "allow"
  },
  {
   "at": 33000,
   "do": "actionGet"
  },
  {
   "at": 36000,
   "do": "followup"
  }
 ]
}