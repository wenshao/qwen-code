{
 "name": "cand-approval-cancel",
 "arm": "cand",
 "springArgs": [
  "--qwen.managed-agent.harness.turn-deadline=300s"
 ],
 "springEnv": {
  "QWEN_MANAGED_AGENT_APPROVAL_MODE": "default",
  "QWEN_MANAGED_AGENT_APPROVAL_TIMEOUT": "90s"
 },
 "prompt": "[WRITE] write the probe file",
 "windowMs": 50000,
 "steps": [
  {
   "at": 10000,
   "do": "actions"
  },
  {
   "at": 12000,
   "do": "cancel"
  },
  {
   "at": 20000,
   "do": "actionGet"
  },
  {
   "at": 21000,
   "do": "respond",
   "option": "allow"
  },
  {
   "at": 24000,
   "do": "followup"
  }
 ]
}