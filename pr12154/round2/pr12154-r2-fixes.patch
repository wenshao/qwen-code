+describe('worktreeHoldsSubmodules, on a path it cannot decode', () => {
+  it('treats a gitlink whose path is not UTF-8 as a repository', async () => {
+    // The index holds bytes and the stream decodes them as UTF-8, so a
+    // Latin-1 name comes back with a replacement character that names
+    // nothing on disk — and "not found" must not read as "no repository".
+    if (process.platform === 'win32') return;
+    const outer = makeRepo();
+    const wt = path.join(path.dirname(outer), 'wt');
+    git(outer, 'worktree', 'add', '-q', wt, '-b', 'side');
+    const target = Buffer.concat([
+      Buffer.from(`${wt}${path.sep}`),
+      Buffer.from([0x76, 0x65, 0x6e, 0x64, 0xe9]), // "vend\xe9"
+    ]);
+    try {
+      fs.renameSync(makeRepo(), target);
+    } catch (err) {
+      // A volume that only stores valid UTF-8 names cannot hold this shape.
+      if ((err as NodeJS.ErrnoException).code === 'EILSEQ') return;
+      throw err;
+    }
+    git(wt, '-c', 'advice.addEmbeddedRepo=false', 'add', '-A');
+    git(wt, 'commit', '-q', '-m', 'gitlink');
+    expect(await worktreeHoldsSubmodules(wt)).toBe(true);
+  }, 30_000);
+});
