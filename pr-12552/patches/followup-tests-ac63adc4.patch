+    @Test
+    void stopAndCloseEndTheWorkerProcess(@TempDir Path temp)
+            throws Exception {
+        assumeTrue(commandExists("node"), "node is required");
+        Path stopped = temp.resolve("stopped");
+        Path closed = temp.resolve("closed");
+        LocalProcessRuntimeProvisioner provisioner = provisioner("ok",
+                stopped);
+        RuntimeLease lease = provisioner.provision(
+                new RuntimeProvisionRequest(SCOPE, null))
+                .toCompletableFuture().get(30, TimeUnit.SECONDS);
+        provisioner.stop(lease);
+        assertExits(stopped);
+        LocalProcessRuntimeProvisioner other = provisioner("ok", closed);
+        other.provision(new RuntimeProvisionRequest(SCOPE, null))
+                .toCompletableFuture().get(30, TimeUnit.SECONDS);
+        other.close();
+        assertExits(closed);
+        provisioner.close();
