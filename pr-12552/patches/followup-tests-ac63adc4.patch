+            if (ProcessHandle.of(pid).map(h -> !h.isAlive()).orElse(true)) {
+                return;
+            }
+            Thread.sleep(50);
+        }
+        org.junit.jupiter.api.Assertions.fail("worker " + pid + " still runs");
