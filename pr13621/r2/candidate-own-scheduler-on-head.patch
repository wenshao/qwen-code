+package com.alibaba.qwen.code.managedagent.service;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.scheduling.annotation.Scheduled;
+
+/**
+ * The replay-floor pass drains its whole backlog in one tick, which on a
+ * deployment that opts in with many Sessions takes minutes; it must run on
+ * its own scheduler, not the one-thread default that the message
+ * materializer and the recovery ticks share.
+ */
+class ReplayFloorSchedulerTest {
+
+    @Test
+    void thePassDoesNotShareTheDefaultScheduler() throws Exception {
+        Scheduled scheduled = ReplayFloorAdvancer.class.getMethod("advance")
+                .getAnnotation(Scheduled.class);
+
+        assertThat(scheduled.scheduler()).isEqualTo("replayFloorScheduler");
+    }
+}
