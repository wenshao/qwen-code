+// The Session Store's own key rules (ManagedSessionStore.validateScope):
+// a tenant id fits 128 UTF-8 bytes, and a workspace or session id is a safe
+// key component, so no committed row can name an id the envelope refuses.
+const MAX_TENANT_ID_BYTES = 128;
+
+function keyComponent(value: ManagedSessionJsonValue, label: string): string {
+  const id = assertManagedSessionStableId(value, label);
+  if (id.includes('/') || id.includes('\\') || /^\.+$/.test(id)) {
+    fail(`${label} must be a safe key component.`);
+  }
+  return id;
+}
