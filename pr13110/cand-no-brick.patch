+
+it('answers Write/Edit with an error and keeps the Session usable when the worker refuses the backup', async () => {
+  broker.fileHistory.mockImplementation(async (operation) => {
+    if (operation.action === 'prepare')
+      throw new HostedWorkspaceBrokerRejection(
+        409,
+        'managed_runtime_provider_operation_failed',
+        undefined,
+        'Hosted file changed outside tracked mutations.',
+      );
+    return {
+      ownerSessionId: session.authority.sessionHeader.sessionKey.sessionId,
+      snapshots: [],
+      files: {},
+    };
+  });
+  broker.execute.mockResolvedValue({
+    executionStatus: 'success',
+    responseParts: [{ text: 'read' }],
+  });
+  const responses = await turn.execute(
+    calls,
+    parts,
+    'model',
+    new AbortController().signal,
+  );
+  // read_file ran; the edit was answered without being dispatched.
+  expect(broker.execute).toHaveBeenCalledTimes(1);
+  expect(JSON.stringify(responses)).toContain(
+    'Hosted file changed outside tracked mutations.',
+  );
+  expect(await readHostedFileHistory(session)).toBeUndefined();
+  await turn.consumeResults();
+  await turn.finish();
+  expect(broker.release).toHaveBeenCalledOnce();
+});
+
+it('gives the Workspace back and fails only the turn when the saved history cannot be bound', async () => {
+  broker.fileHistory.mockRejectedValue(
+    new HostedWorkspaceBrokerRejection(
+      409,
+      'managed_runtime_provider_operation_failed',
+      undefined,
+      'Hosted file history backup is unavailable.',
+    ),
+  );
+  const failure = await turn
+    .execute(calls, parts, 'model', new AbortController().signal)
+    .catch((cause: unknown) => cause);
+  expect(failure).toBeInstanceOf(Error);
+  expect(failure).not.toBeInstanceOf(HostedToolRecoveryRequiredError);
+  expect(broker.execute).not.toHaveBeenCalled();
+  expect(broker.release).toHaveBeenCalledOnce();
+  await expect(turn.finish()).resolves.toBeUndefined();
+});
