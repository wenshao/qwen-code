# PublicCommandOperation   (contract 1.22.0 -> 1.23.0)
TIGHTEN  ACCEPT -> REJECT   task_cancel status=cancelled
TIGHTEN  ACCEPT -> REJECT   task_cancel failed, no failure_code
TIGHTEN  ACCEPT -> REJECT   task_cancel recovery_blocked, delivery still pending
TIGHTEN  ACCEPT -> REJECT   task_cancel completed without harness_confirmed admission
        ACCEPT -> ACCEPT   task_cancel completed, confirmed, with receipt
        ACCEPT -> ACCEPT   task_cancel failed + failure_code + blocked
        ACCEPT -> ACCEPT   task_cancel pending (in flight)

# PublicOperation   (contract 1.22.0 -> 1.23.0)
TIGHTEN  ACCEPT -> REJECT   task_cancel status=cancelled
