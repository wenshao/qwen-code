+// Ajv caches every compiled schema by object identity for the life of the
+// process. Callers that rebuild their tools (and so their schema objects) for
+// each call would otherwise add one compiled validator per call.
+const compiledByText = new WeakMap<Ajv, Map<string, ValidateFunction>>();
+
+function compileOnce(validator: Ajv, schema: AnySchema): ValidateFunction {
+  let key: string;
+  try {
+    key = JSON.stringify(schema);
+  } catch {
+    return validator.compile(schema);
+  }
+  let byText = compiledByText.get(validator);
+  if (!byText) {
+    byText = new Map();
+    compiledByText.set(validator, byText);
+  }
+  let validate = byText.get(key);
+  if (!validate) {
+    validate = validator.compile(schema);
+    byText.set(key, validate);
+  }
+  return validate;
+}
