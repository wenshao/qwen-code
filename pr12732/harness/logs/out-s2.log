mount roots: W1=$BASE/workspace-1  W2=$BASE/workspace-2
W1 sess-api  cwdRelative=services/api install=200  shell pwd=$BASE/workspace-1/services/api  write=success edit=success read=success (content ok)
W1 sess-web  cwdRelative=apps/web     install=200  shell pwd=$BASE/workspace-1/apps/web  write=success edit=success read=success (content ok)
W1 sess-root cwdRelative=.            install=200  shell pwd=$BASE/workspace-1  write=success edit=success read=success (content ok)
W2 sess-api  cwdRelative=services/api install=200  shell pwd=$BASE/workspace-2/services/api  write=success edit=success read=success (content ok)
--- files on disk (find $BASE -name "*.txt") ---
$BASE/workspace-1/apps/web/note.txt      final by W1:sess-web
$BASE/workspace-1/apps/web/shell.txt     W1:sess-web
$BASE/workspace-1/note.txt               final by W1:sess-root
$BASE/workspace-1/services/api/note.txt  final by W1:sess-api
$BASE/workspace-1/services/api/shell.txt W1:sess-api
$BASE/workspace-1/shell.txt              W1:sess-root
$BASE/workspace-2/services/api/note.txt  final by W2:sess-api
$BASE/workspace-2/services/api/shell.txt W2:sess-api
