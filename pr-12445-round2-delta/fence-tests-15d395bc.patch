+    private static void verifyExecutionPayloadShapes(DataSource dataSource,
+            String prefix) {
+        JdbcToolExecutionRepository writer =
+                new JdbcToolExecutionRepository(dataSource);
+        String key = prefix + "-shape-idempotency";
+        Map<String, Object> nested = new LinkedHashMap<>();
+        nested.put("attempt", 1L);
+        nested.put("note", null);
+        Map<String, Object> shape = new LinkedHashMap<>();
+        shape.put("nested", nested);
+        shape.put("list", java.util.Arrays.asList(1L, null, "x"));
+        ToolExecutionRecord candidate = shaped(prefix, key, shape);
+        writer.findOrCreate(candidate);
+        ToolExecutionRecord reread = new JdbcToolExecutionRepository(
+                dataSource).findByIdempotencyKey(key);
+        assertTrue(reread.sameRequest(candidate));
+
+        Map<String, Object> extra = new LinkedHashMap<>(shape);
+        extra.put("extra", "x");
+        assertFalse(reread.sameRequest(shaped(prefix, key, extra)));
+        Map<String, Object> renamed = new LinkedHashMap<>(shape);
+        renamed.put("renamed", null);
+        Map<String, Object> renamedTwin = new LinkedHashMap<>(shape);
+        renamedTwin.put("other", null);
+        assertFalse(shaped(prefix, key, renamed).sameRequest(
+                shaped(prefix, key, renamedTwin)));
+        Map<String, Object> shorter = new LinkedHashMap<>(shape);
+        shorter.put("list", java.util.Arrays.asList(1L, null));
+        assertFalse(reread.sameRequest(shaped(prefix, key, shorter)));
+    }
+
+    private static ToolExecutionRecord shaped(String prefix, String key,
+            Map<String, Object> extra) {
+        Map<String, Object> reference = new LinkedHashMap<>(extra);
+        reference.put("sessionId", prefix + "-shape-runtime-session");
+        reference.put("promptId", prefix + "-shape-turn");
+        reference.put("callId", prefix + "-shape-tool");
+        reference.put("argsDigest", prefix + "-shape-digest");
+        return ToolExecutionRecord.prepared(key + "-execution", key,
+                prefix + "-shape-binding", 1, prefix + "-shape-harness",
+                prefix + "-shape-runtime-session", prefix + "-shape-turn",
+                prefix + "-shape-tool", prefix + "-shape-digest", reference);
+    }
