+    @Test
+    void rejectsAProofFromAnotherRuntimeLeaseOrProvision() throws Exception {
+        String[][] changes = {
+            {"runtimeInstanceId", "runtime-other"},
+            {"runtimeIncarnation", "boot-other"},
+            {"leaseId", "lease-other"},
+            {"provisionRequestId", "provision-other"},
+        };
+        for (String[] change : changes) {
+            ObjectNode body = successBody();
+            body.put(change[0], change[1]);
+            reply.set(json(200, JSON.writeValueAsBytes(body)));
+
+            RuntimeBrokerException failure = awaitFailure();
+
+            assertEquals(409, failure.getStatusCode(), change[0]);
+        }
+        ObjectNode body = successBody();
+        body.put("epoch", body.required("epoch").longValue() + 1);
+        reply.set(json(200, JSON.writeValueAsBytes(body)));
+        assertEquals(409, awaitFailure().getStatusCode(), "epoch");
+    }
+
+    @Test
+    void rejectsAMalformedSuccessResponse() throws Exception {
+        byte[] valid = JSON.writeValueAsBytes(successBody());
+        java.util.List<Reply> replies = new java.util.ArrayList<>();
+        replies.add(new Reply(200, valid, "private", "application/json"));
+        replies.add(new Reply(200, valid, "no-store", "text/plain"));
+        replies.add(new Reply(200, valid, "no-store",
+                "application/json; charset=utf-16"));
+        ObjectNode extra = successBody();
+        extra.put("debug", true);
+        replies.add(json(200, JSON.writeValueAsBytes(extra)));
+        ObjectNode version = successBody();
+        version.put("protocolVersion", 3);
+        replies.add(json(200, JSON.writeValueAsBytes(version)));
+        ObjectNode zero = successBody();
+        zero.put("epoch", 0);
+        replies.add(json(200, JSON.writeValueAsBytes(zero)));
+        ObjectNode fraction = successBody();
+        fraction.put("epoch", 4.5);
+        replies.add(json(200, JSON.writeValueAsBytes(fraction)));
+        for (Reply planned : replies) {
+            reply.set(planned);
+
+            RuntimeBrokerException failure = awaitFailure();
+
+            assertEquals(400, failure.getStatusCode());
+            assertEquals("managed_runtime_attestation_invalid",
+                    failure.getCode());
+        }
+    }
