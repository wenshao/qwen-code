+package com.alibaba.qwen.code.managedagent;
+
+import java.util.UUID;
+import javax.sql.DataSource;
+import org.flywaydb.core.Flyway;
+import org.junit.jupiter.api.Test;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.jdbc.datasource.DriverManagerDataSource;
+
+/**
+ * Runs the shared H5 channel persistence contract against the Flyway schema
+ * on the MySQL gate, where the utf8mb4_bin collation and the InnoDB
+ * duplicate-key path that H2 cannot model are real.
+ */
+class ManagedChannelJdbcContractMySqlIT {
+    @Test
+    void channelPersistenceKeepsItsContractOnMySql() {
+        String url = System.getProperty("mysql.url");
+        if (url == null || !url.matches("jdbc:mysql://[^/]+/[^?]+(?:\\?.*)?")) {
+            throw new IllegalArgumentException(
+                    "A MySQL test database URL is required");
+        }
+        String user = System.getProperty("mysql.user");
+        String password = System.getProperty("mysql.password", "");
+        JdbcTemplate admin = new JdbcTemplate(
+                new DriverManagerDataSource(url, user, password));
+        String schema = "channel_contract_"
+                + UUID.randomUUID().toString().replace("-", "");
+        admin.execute("CREATE DATABASE " + schema);
+        try {
+            DataSource dataSource = new DriverManagerDataSource(
+                    url.replaceFirst("/[^/?]+(?=\\?|$)", "/" + schema), user,
+                    password);
+            Flyway.configure().dataSource(dataSource)
+                    .locations("classpath:db/migration").load().migrate();
+            ManagedChannelJdbcContract.verify(dataSource,
+                    "mysql-" + UUID.randomUUID());
+        } finally {
+            admin.execute("DROP DATABASE " + schema);
+        }
+    }
+}
