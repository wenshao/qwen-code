diff --git a/packages/sdk-java/managed-agent-server/src/main/java/com/alibaba/qwen/code/managedagent/store/ChannelStoreSupport.java b/packages/sdk-java/managed-agent-server/src/main/java/com/alibaba/qwen/code/managedagent/store/ChannelStoreSupport.java
index d371cfac8c..647a690d4c 100644
--- a/packages/sdk-java/managed-agent-server/src/main/java/com/alibaba/qwen/code/managedagent/store/ChannelStoreSupport.java
+++ b/packages/sdk-java/managed-agent-server/src/main/java/com/alibaba/qwen/code/managedagent/store/ChannelStoreSupport.java
@@ -25,4 +25,18 @@ final class ChannelStoreSupport {
         }
         return value;
     }
+
+    /**
+     * An identity the store compares in SQL. The utf8mb4_bin collation pads
+     * with spaces, so MySQL and MariaDB treat "id" and "id " as one value:
+     * a trailing space would alias another identity's row, so it is refused.
+     */
+    static String requireKey(String value, String name) {
+        requireId(value, name);
+        if (value.endsWith(" ")) {
+            throw new IllegalArgumentException(name
+                    + " must not end with a space");
+        }
+        return value;
+    }
 }
