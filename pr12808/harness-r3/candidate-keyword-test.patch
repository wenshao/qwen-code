+    @Test
+    void specSchemasUseOnlyKnownKeywords() {
+        Map<String, String> unknown = new TreeMap<>();
+        for (Map.Entry<String, JsonNode> schema
+                : CONTRACT.node("/components/schemas").properties()) {
+            collectUnknownKeywords(schema.getValue(),
+                    "/components/schemas/" + schema.getKey(), unknown);
+        }
+        assertThat(unknown.keySet()).as(
+                "keywords outside JSON Schema 2020-12 and OpenAPI in %s",
+                OpenApiContract.RESOURCE).isEmpty();
+    }
+
+    private static void collectUnknownKeywords(JsonNode schema,
+            String pointer, Map<String, String> unknown) {
+        if (!schema.isObject()) {
+            return;
+        }
+        for (Map.Entry<String, JsonNode> entry : schema.properties()) {
+            String keyword = entry.getKey();
+            JsonNode value = entry.getValue();
+            String child = pointer + "/" + keyword;
+            if (!keyword.startsWith("x-")
+                    && !SCHEMA_KEYWORDS.contains(keyword)) {
+                unknown.put(child, "");
+            }
+            switch (keyword) {
+                case "properties", "patternProperties", "$defs",
+                        "dependentSchemas" -> {
+                    for (Map.Entry<String, JsonNode> member
+                            : value.properties()) {
+                        collectUnknownKeywords(member.getValue(),
+                                child + "/" + member.getKey(), unknown);
+                    }
+                }
+                case "items", "not", "if", "then", "else", "contains",
+                        "additionalProperties", "propertyNames",
+                        "unevaluatedProperties", "unevaluatedItems" ->
+                        collectUnknownKeywords(value, child, unknown);
+                case "allOf", "anyOf", "oneOf", "prefixItems" -> {
+                    for (int i = 0; i < value.size(); i++) {
+                        collectUnknownKeywords(value.get(i), child + "/" + i,
+                                unknown);
+                    }
+                }
+                default -> {
+                }
+            }
+        }
+    }
