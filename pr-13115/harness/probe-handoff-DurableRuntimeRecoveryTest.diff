+            await(() -> recovered.reconciliations.get() > 0,
+                    Duration.ofSeconds(2));
+            bindings.handoffSleepMillis = 800;
+            recovered.reconcileGate.complete(RuntimeObservation.notFound(
+                    RuntimeRecoveryContract.evidence(original,
