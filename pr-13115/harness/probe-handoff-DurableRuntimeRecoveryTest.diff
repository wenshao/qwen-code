+     * lease lapses the claim before cleanupLost's first renew.
+     */
+    @Test
+    void probeLostHandoffRenewsBeforeTheFirstRecoverLost() throws Exception {
+        ReclaimWatchRepository bindings = new ReclaimWatchRepository(
+                new InMemoryRuntimeBindingRepository());
