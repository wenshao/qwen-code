+    const adapter = make();
+    await adapter.connect();
+    // A stale process's late disconnect: the server refuses the admission
+    // with channel_disconnected until this adapter registers again.
+    plane.submitErrors = [{ status: 409, code: 'channel_disconnected' }];
+    append(raw('late', 'after a late disconnect'));
+    await adapter.tick();
+    expect(state(adapter).pending).toHaveLength(1);
+    expect(plane.registrations).toEqual([{ accountGeneration: 1 }]);
+    await adapter.tick();
+    expect(plane.registrations).toEqual([
+      { accountGeneration: 1 },
+      { accountGeneration: 1 },
+    ]);
+    expect(state(adapter).pending).toEqual([]);
+    expect(plane.events.at(-1)).toMatchObject({
+      text: 'after a late disconnect',
+    });
+  });
+
+  it('re-registers when the outbox claim finds the channel disconnected', async () => {
+    const adapter = make();
+    await adapter.connect();
+    const claim = plane.claimDeliveries.bind(plane);
+    plane.claimDeliveries = async () => {
+      throw Object.assign(new Error('HTTP 409'), {
+        status: 409,
+        code: 'channel_disconnected',
+      });
+    };
+    await expect(adapter.tick()).rejects.toThrow('HTTP 409');
+    plane.claimDeliveries = claim;
+    await adapter.tick();
+    expect(plane.registrations).toEqual([
+      { accountGeneration: 1 },
+      { accountGeneration: 1 },
+    ]);
+  });
