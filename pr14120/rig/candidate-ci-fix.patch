       # whose supervision needs a delegated cgroup v2 root; ubuntu-latest's
       # kernel has the interface, and the job delegates one subtree to
       # itself (the supervisor uses the core cgroup v2 files only, so no
-      # controller delegation is needed).
+      # controller delegation is needed). A non-root process may migrate only
+      # within a subtree whose common ancestor it can write, so the Verify
+      # step first moves its own shell into the fg8/job leaf: the units the
+      # supervisor creates under fg8 then share the chowned fg8 ancestor.
       - name: 'Delegate a cgroup v2 root for the process gates'
         run: |-
-          sudo mkdir -p /sys/fs/cgroup/fg8
+          sudo mkdir -p /sys/fs/cgroup/fg8/job
           sudo chown -R "$(id -u):$(id -g)" /sys/fs/cgroup/fg8
           test -f /sys/fs/cgroup/fg8/cgroup.kill
       - name: 'Verify Hosted Java, Spring and MySQL processes'
@@ -820,6 +823,7 @@
           MYSQL_PORT: "${{ job.services.mysql.ports['3306'] }}"
           QWEN_MANAGED_HOOK_CGROUP_ROOT: '/sys/fs/cgroup/fg8'
         run: >-
+          echo "$$" | sudo tee /sys/fs/cgroup/fg8/job/cgroup.procs > /dev/null &&
           mvn --batch-mode --no-transfer-progress -f packages/sdk-java/managed-agent-server/pom.xml
           -Phosted-harness-mysql
