+                + " idempotency_key, request_digest, state, admission_stage,"
+                + " delivery_state, session_status_before, available_at,"
+                + " created_at, updated_at) VALUES ('tenant', 'session',"
+                + " 'op', 'CLOSE', '', 'key', 'digest', 'COMPLETED',"
+                + " 'JAVA_DURABLE', 'CONFIRMED', 'ACTIVE', 0, 0, 0)");
+        jdbc.execute("SET REFERENTIAL_INTEGRITY TRUE");
         assertThat(store.findOperation("tenant", "session", "op"))
-                .isEmpty();
+                .hasValueSatisfying(operation -> {
+                    assertThat(operation.kind()).isEqualTo(
+                            StoreModels.OperationKind.CLOSE);
+                    assertThat(operation.targetCwdRelative()).isNull();
+                    assertThat(operation.expectedContextRevision()).isNull();
+                });
 
         // After the upgrade the same reads work unchanged.
         Flyway.configure().dataSource(dataSource)
                 .locations("classpath:db/migration").load().migrate();
         assertThat(store.findOperation("tenant", "session", "op"))
-                .isEmpty();
+                .hasValueSatisfying(operation -> assertThat(
+                        operation.targetCwdRelative()).isNull());
     }
 }
