@@ -36,14 +37,31 @@ class ManagedOperationSchemaUpgradeTest {
                 }, new ManagedWorkspaceRegistry(jdbc),
                 new ManagedAgentProperties());
         // Pinned at V31 the operation table has no cwd columns: the read
-        // must answer instead of failing with bad SQL grammar.
+        // must answer instead of failing with bad SQL grammar. The mapper
+        // only reaches those columns for a row, so seed one (a close admitted
