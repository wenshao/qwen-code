+
+// The split reads `mcp__foo____*` as server `foo` and `mcp__a__b___*` as
+// server `a`, so an identity-threaded wildcard whose tool side is pure
+// underscores loses the key it was copied from when that key ends in `_` or
+// contains `__` (sandbox F13, R17-1). Grants keep the split's reading.
+describe('pure-underscore prefixes the split misreads (F13 / R17-1)', () => {
+  it.each([
+    ['foo_', '__x', 'mcp__foo_____*'],
+    ['foo_', '_internal', 'mcp__foo____*'],
+    ['foo__', '_internal', 'mcp__foo_____*'],
+    ['foo__', '__x', 'mcp__foo______*'],
+    ['a_', '_b', 'mcp__a____*'],
+    ['a__b', '_hidden', 'mcp__a__b___*'],
+    ['my__svc', '_internal', 'mcp__my__svc___*'],
+  ])(
+    'restrictive rules keep covering %s / %s under %s, grants do not',
+    async (server, name, rule) => {
+      const tool = prodTool(server, name);
+      // The rule is a literal prefix of the tool's own registered name.
+      expect(tool.name.startsWith(rule.slice(0, -1))).toBe(true);
+      const ctx = ctxOf(tool);
+      expect(
+        matchesToolPattern(
+          rule,
+          tool.name,
+          tool.permissionAliases,
+          ctx.mcpIdentity,
+        ),
+      ).toBe(true);
+      const deny = new PermissionManager(
+        makeConfig({ permissionsDeny: [rule] }),
+      );
+      deny.initialize();
+      expect(await deny.evaluate(ctx)).toBe('deny');
+      expect(
+        await deny.isToolEnabled(
+          tool.name,
+          tool.permissionAliases,
+          ctx.mcpIdentity,
+        ),
+      ).toBe(false);
+      const ask = new PermissionManager(makeConfig({ permissionsAsk: [rule] }));
+      ask.initialize();
+      expect(await ask.evaluate(ctx)).toBe('ask');
+      const allow = new PermissionManager(
+        makeConfig({ permissionsAllow: [rule] }),
+      );
+      allow.initialize();
+      expect(await allow.evaluate(ctx)).toBe('default');
+    },
+  );
+
+  it('a foreign tool prefix at the key own boundary stays unmatched', async () => {
+    const tool = prodTool('foo_', '_internal');
+    const ctx = ctxOf(tool);
+    expect(
+      matchesToolPattern(
+        'mcp__foo___zz*',
+        tool.name,
+        tool.permissionAliases,
+        ctx.mcpIdentity,
+      ),
+    ).toBe(false);
+    const deny = new PermissionManager(
+      makeConfig({ permissionsDeny: ['mcp__foo___zz*'] }),
+    );
+    deny.initialize();
+    expect(await deny.evaluate(ctx)).toBe('default');
+  });
+});
