[Unit]
Description=Qwen managed agent server (PR 12869 verification rig)
After=docker.service network-online.target
Wants=docker.service

[Service]
User=wenshao
WorkingDirectory=/var/lib/qwen-rt
ExecStart=/opt/qwen/run-server.sh
Restart=on-failure
RestartSec=3
KillMode=process

[Install]
WantedBy=multi-user.target
