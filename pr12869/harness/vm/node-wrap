#!/bin/bash
# Rig only: lets one worker launch die before READY (interrupted startup) while the flag file exists.
if [ -e /var/lib/qwen-rt/fail-worker ]; then
  echo "$(date -u +%FT%T.%3NZ) worker launch refused by the rig flag (pid $$)" >> /var/log/qwen-w0e3/node-wrap.log
  exit 1
fi
exec /opt/qwen/node "$@"
