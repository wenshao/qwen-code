+it('adopts the provisional prompt id when the sender-local live block has no identity', async () => {
+  // The submitting client's own user block is a local echo: the daemon's
+  // record-stamped echo is suppressed, so it never gains a record or prompt id.
+  connection.sessionId = 'session';
+  prompt.status = 'streaming';
+  transcript.blocks = [userBlock('live', 1)];
+  navigation.provisionalTurns = [
+    {
+      promptId: 'prompt-live',
+      provisionalId: 'live:prompt-live',
+      blockId: 'live',
+      label: 'Running prompt',
+    },
+  ];
+  const onSelect = vi.fn();
+  await act(async () =>
+    render(<TurnCallsPanel turnId="live" onSelectPrompt={onSelect} />),
+  );
+  expect(onSelect).toHaveBeenCalledWith(
+    'live',
+    undefined,
+    'prompt-live',
+    undefined,
+  );
+  expect(client.getSessionToolCalls).not.toHaveBeenCalled();
+});
+
+it('does not retarget a tab that already has a durable identity', async () => {
+  connection.sessionId = 'session';
+  prompt.status = 'streaming';
+  transcript.blocks = [userBlock('live', 1)];
+  navigation.provisionalTurns = [
+    {
+      promptId: 'prompt-live',
+      provisionalId: 'live:prompt-live',
+      blockId: 'live',
+      label: 'Running prompt',
+    },
+  ];
+  const onSelect = vi.fn();
+  await act(async () =>
+    render(
+      <TurnCallsPanel
+        turnId="live"
+        promptId="prompt-live"
+        onSelectPrompt={onSelect}
+      />,
+    ),
+  );
+  expect(onSelect).not.toHaveBeenCalled();
+});
