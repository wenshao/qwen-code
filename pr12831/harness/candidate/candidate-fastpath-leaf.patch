index 0000000000..7b50886c1a
--- /dev/null
+++ b/packages/cli/src/serve/managed-runtime-broker-url.ts
@@ -0,0 +1,36 @@
+/**
+ * @license
+ * Copyright 2026 Qwen Team
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+// Leaf module: the serve pre-listen profile validator imports this, so it must
+// not pull the Broker provider (and through it the ACP bridge) into the
+// fast-path closure.
+import { isLoopbackBind } from './loopback-binds.js';
+
+export function resolveManagedRuntimeBrokerBaseUrl(raw: string): URL {
+  let url: URL;
+  try {
+    url = new URL(raw);
+  } catch {
+    throw new Error('Managed Runtime Broker URL is invalid.');
+  }
+  if (
+    (url.protocol !== 'http:' && url.protocol !== 'https:') ||
+    url.username ||
+    url.password ||
+    url.search ||
+    url.hash ||
+    (url.pathname !== '/' && url.pathname !== '')
+  ) {
+    throw new Error('Managed Runtime Broker URL must be an HTTP(S) origin.');
+  }
+  if (url.protocol === 'http:' && !isLoopbackBind(url.hostname)) {
+    throw new Error(
+      'Managed Runtime Broker URL must use HTTPS outside the loopback interface.',
+    );
+  }
+  url.pathname = '/';
+  return url;
+}
