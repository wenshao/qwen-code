+
+describe('local managed tool-result guards', () => {
+  it('refuses a seal that would drop an acknowledged tail segment', async () => {
+    const { store } = await harness();
+    const parts = ['alpha-', 'beta-', 'gamma'].map((part) => Buffer.from(part));
+    for (const [ordinal, bytes] of parts.entries()) {
+      expect(
+        (
+          await store.publish({
+            captureId: 'capture',
+            streamId: 'stdout',
+            ordinal,
+            bytes,
+          })
+        ).status,
+      ).toBe('ok');
+    }
+    await fs.rm(
+      path.join(
+        store.root,
+        'capture-capture',
+        'stream-stdout',
+        'segment-00002',
+      ),
+      { recursive: true },
+    );
+    const kept = Buffer.concat(parts.slice(0, 2));
+    expect(
+      await store.seal({
+        captureId: 'capture',
+        streamId: 'stdout',
+        segmentCount: 2,
+        byteLength: kept.byteLength,
+        digest: digest(kept),
+      }),
+    ).toEqual({ status: 'refused', code: 'managed_tool_result_conflict' });
+  });
+
+  it('refuses a page whose segment digest differs from the stored segment', async () => {
+    const { store, runtimeBaseDir } = await harness();
+    const stored = Buffer.from('alpha');
+    const pinned = Buffer.from('omega');
+    await store.publish({
+      captureId: 'capture-01',
+      streamId: 'stdout',
+      ordinal: 0,
+      bytes: stored,
+    });
+    const resources = LocalManagedSessionResourceStore.create({
+      runtimeBaseDir,
+      sessionKey,
+    });
+    const page = {
+      toolResult: 'managed-tool-result/1',
+      type: 'page',
+      captureId: 'capture-01',
+      streamId: 'stdout',
+      firstOrdinal: 0,
+      offset: 0,
+      segments: [{ byteLength: 5, digest: digest(pinned) }],
+    };
+    const pageRef = await resources.publish(
+      'managed-tool-result-page',
+      Buffer.from(JSON.stringify(page)),
+    );
+    const base = parseToolResultManifest(fixtures.manifest);
+    const manifest: ToolResultManifest = {
+      ...base,
+      contents: [
+        {
+          ...base.contents[0],
+          byteLength: 5,
+          digest: digest(pinned),
+          body: { pages: [{ ref: pageRef, segmentCount: 1, byteLength: 5 }] },
+        },
+        ...base.contents.slice(1),
+      ],
+    };
+    const manifestRef = await resources.publish(
+      'managed-tool-result-manifest',
+      Buffer.from(JSON.stringify(manifest)),
+    );
+    expect(
+      await store.readRange({
+        manifestRef,
+        expectedIdentity: identityOf(manifest),
+        streamId: 'stdout',
+        offset: 0,
+        length: 5,
+      }),
+    ).toEqual({
+      status: 'refused',
+      code: 'managed_tool_result_digest_mismatch',
+    });
+  });
+
+  it('does not replace an acknowledged stream after its capture directory is removed', async () => {
+    const { store } = await harness();
+    const request = {
+      captureId: 'capture',
+      streamId: 'stdout',
+      ordinal: 0,
+      bytes: Buffer.from('original'),
+    };
+    expect((await store.publish(request)).status).toBe('ok');
+    await fs.rm(path.join(store.root, 'capture-capture'), { recursive: true });
+    expect(
+      await store.publish({ ...request, bytes: Buffer.from('different') }),
+    ).toEqual({
+      status: 'refused',
+      code: 'managed_tool_result_digest_mismatch',
+    });
+  });
+
+  it('stops acknowledging when the Session transcript changes outside its writer', async () => {
+    const { store, transcriptPath } = await harness();
+    await fs.appendFile(transcriptPath, '{"foreign":true}\n');
+    await expect(
+      store.publish({
+        captureId: 'capture',
+        streamId: 'stdout',
+        ordinal: 0,
+        bytes: Buffer.from('late'),
+      }),
+    ).rejects.toThrow(/changed outside its active writer/);
+  });
+
+  it('rejects a writer lease that belongs to another Session', async () => {
+    const { runtimeBaseDir } = await harness();
+    const lease = await SessionWriterLease.acquire({
+      runtimeBaseDir,
+      sessionId: 'session-b',
+      transcriptPath: path.join(runtimeBaseDir, 'chats', 'session-b.jsonl'),
+    });
+    try {
+      await expect(
+        LocalToolResultSegmentStore.openWritable({ lease, sessionKey }),
+      ).rejects.toThrow(/another Session/);
+    } finally {
+      await lease.release();
+    }
+  });
+});
