hot reload replay
@@tool lsp {"operation":"hover","filePath":"src/doc.txt","line":1,"character":1}
@@tool lsp {"operation":"hover","filePath":"src/other.txt","line":1,"character":1}
@@tool run_shell_command {"command":"printf 'alpha AFTER-RELOAD\\nbeta\\n' > src/doc.txt; node -e \"const f='.lsp.json',j=JSON.parse(require('fs').readFileSync(f));j.plaintext.env.RELOAD='1';require('fs').writeFileSync(f,JSON.stringify(j))\"; sleep 7","description":"edit doc + change .lsp.json env (restart)"}
@@tool lsp {"operation":"workspaceDiagnostics"}
@@tool lsp {"operation":"hover","filePath":"src/doc.txt","line":1,"character":1}
