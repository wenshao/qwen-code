crash and replay
@@tool lsp {"operation":"hover","filePath":"src/doc.txt","line":1,"character":1}
@@tool lsp {"operation":"hover","filePath":"src/other.txt","line":1,"character":1}
@@tool run_shell_command {"command":"kill $(jq -r .pid /root/git/pr11443-e2e/out/s3-pr.fake.jsonl | tail -1); sleep 4","description":"crash the LSP server"}
@@tool run_shell_command {"command":"printf 'alpha AFTER-CRASH\\nbeta\\n' > src/doc.txt; printf 'other AFTER-CRASH\\n' > src/other.txt","description":"edit both files while server restarts"}
@@tool lsp {"operation":"workspaceDiagnostics"}
@@tool lsp {"operation":"hover","filePath":"src/other.txt","line":1,"character":1}
@@tool lsp {"operation":"hover","filePath":"src/doc.txt","line":1,"character":1}
