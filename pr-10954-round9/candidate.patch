+/**
+ * The live-session registry, or a throw when it cannot be read.
+ *
+ * `listLiveSessions` promises never to throw — its interactive callers
+ * need that — so an unreadable registry directory reads as "no
+ * sessions". Here that is not harmless: a managed row whose pid only the
+ * registry proves would be reconciled to `failed` and published in a
+ * complete-looking 200. Probing the directory first sends that case down
+ * the same 503 path as an unreadable supervisor store.
+ */
+async function listLiveSessionsOrThrow(): ReturnType<typeof listLiveSessions> {
+  try {
+    await fs.readdir(getSessionRegistryDir());
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error;
+  }
+  return listLiveSessions();
