+          toolName: 'glob',
+          input: { pattern: '**/*.ts' },
+        })
+      ).json();
+
+      expect(searched.result.executionStatus).toBe('success');
+      expect(JSON.stringify(searched)).toContain('index.ts');
+      expect(terminate).toHaveBeenCalledTimes(1);
+    } finally {
+      terminate.mockRestore();
+    }
+  });
