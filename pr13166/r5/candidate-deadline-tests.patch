+  it.each(['timeout', 'cancel'] as const)(
+    'stops the matching thread before a %s settles',
+    async (ending) => {
+      // A thread that is never terminated keeps backtracking after the
+      // search has answered; nothing else in the result reveals it.
+      const events: string[] = [];
+      const terminate = Worker.prototype.terminate;
+      const spy = vi
+        .spyOn(Worker.prototype, 'terminate')
+        .mockImplementation(function (this: Worker) {
+          return terminate.call(this).then((code) => {
+            events.push('terminated');
+            return code;
+          });
+        });
+      const controller = new AbortController();
+      const cancel =
+        ending === 'cancel'
+          ? setTimeout(
+              () => controller.abort(new Error('test cancellation')),
+              300,
+            )
+          : undefined;
+      try {
+        const result = await tool(ending === 'timeout' ? 500 : 10_000)
+          .build({ pattern: '+(?|?|?)Z' })
+          .execute(controller.signal);
+        events.push('settled');
+        expect(result.error?.type).toBe(ToolErrorType.GLOB_EXECUTION_ERROR);
+        expect(events).toEqual(['terminated', 'settled']);
+      } finally {
+        clearTimeout(cancel);
+        spy.mockRestore();
+      }
+    },
+    15_000,
+  );
