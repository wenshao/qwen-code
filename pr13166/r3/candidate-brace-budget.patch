+/**
+ * @license
+ * Copyright 2026 Qwen Team
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+/**
+ * Glob expands `{…}` alternatives and `{a..b}` ranges synchronously on the
+ * managed worker's event loop, and the cost grows faster than the expansion
+ * count; past the Broker's status deadline the execution is left unknown.
+ * Both gates bound the expansion count before minimatch materializes it.
+ */
+export const GLOB_PATTERN_MAX_EXPANSIONS = 4096;
+
+/**
+ * Upper bound on how many patterns brace expansion makes of `pattern`,
+ * saturating at `limit + 1` so a huge range is never enumerated. Adjacent
+ * groups multiply, alternatives add (nested groups included), a
+ * `{a..b[..step]}` range counts its members, and an escaped, unbalanced or
+ * single-alternative brace counts as a literal, as in brace-expansion.
+ */
+export function globBraceExpansions(
+  pattern: string,
+  limit: number = GLOB_PATTERN_MAX_EXPANSIONS,
+): number {
+  const cap = limit + 1;
+  const closing = (open: number, end: number): number => {
+    let depth = 0;
+    for (let i = open; i < end; i++) {
+      const c = pattern[i];
+      if (c === '\\') i++;
+      else if (c === '{') depth++;
+      else if (c === '}' && --depth === 0) return i;
+    }
+    return -1;
+  };
+  const range = (body: string): number | undefined => {
+    const match = /^(-?\d+|[a-zA-Z])\.\.(-?\d+|[a-zA-Z])(?:\.\.(-?\d+))?$/.exec(
+      body,
+    );
+    if (!match) return undefined;
+    const numeric = /\d/.test(match[1]);
+    if (numeric !== /\d/.test(match[2])) return undefined;
+    const from = numeric ? Number(match[1]) : match[1].charCodeAt(0);
+    const to = numeric ? Number(match[2]) : match[2].charCodeAt(0);
+    const step = Math.abs(Number(match[3] ?? 1)) || 1;
+    return Math.min(cap, Math.floor(Math.abs(to - from) / step) + 1);
+  };
+  const sequence = (start: number, end: number): number => {
+    let count = 1;
+    for (let i = start; i < end; i++) {
+      const c = pattern[i];
+      if (c === '\\') {
+        i++;
+        continue;
+      }
+      if (c !== '{') continue;
+      const close = closing(i, end);
+      if (close === -1) continue;
+      count = Math.min(cap, count * group(i + 1, close));
+      i = close;
+    }
+    return count;
+  };
+  const group = (start: number, end: number): number => {
+    const ranged = range(pattern.slice(start, end));
+    if (ranged !== undefined) return ranged;
+    let total = 0;
+    let alternatives = 0;
+    let depth = 0;
+    let from = start;
+    for (let i = start; i <= end; i++) {
+      const c = pattern[i];
+      if (i < end && c === '\\') i++;
+      else if (i < end && c === '{') depth++;
+      else if (i < end && c === '}') depth--;
+      else if (i === end || (c === ',' && depth === 0)) {
+        total = Math.min(cap, total + sequence(from, i));
+        alternatives++;
+        from = i + 1;
+      }
+    }
+    return alternatives > 1 ? total : sequence(start, end);
+  };
+  return sequence(0, pattern.length);
+}
+
+/** Whether `pattern` expands to at most the shared alternative budget. */
+export function globPatternWithinBudget(pattern: string): boolean {
+  return globBraceExpansions(pattern) <= GLOB_PATTERN_MAX_EXPANSIONS;
+}
