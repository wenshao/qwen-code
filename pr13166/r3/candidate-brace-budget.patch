+/**
+ * @license
+ * Copyright 2026 Qwen Team
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import { createRequire } from 'node:module';
+import path from 'node:path';
+import { describe, expect, it } from 'vitest';
+import {
+  globBraceExpansions,
+  GLOB_PATTERN_MAX_EXPANSIONS,
+} from './hosted-glob-budget.js';
+
+// The minimatch that core's glob actually uses, so the count is compared
+// with the expansion glob performs rather than with a re-implementation.
+const coreRequire = createRequire(
+  createRequire(import.meta.url).resolve(
+    '@qwen-code/qwen-code-core/package.json',
+  ),
+);
+const glob = coreRequire.resolve('glob');
+const { braceExpand } = createRequire(glob)(
+  createRequire(glob).resolve('minimatch', { paths: [path.dirname(glob)] }),
+) as { braceExpand: (pattern: string) => string[] };
+
+describe('globBraceExpansions', () => {
+  it.each([
+    '**/*.ts',
+    '{a,b}/*',
+    '{a,b}{a,b}{c,d,e}/*',
+    'a{b,c}d{e,f,g}',
+    '{a,{b,c}}x',
+    '{a}',
+    '\\{a,b}',
+    '{a,b',
+    '{1..5}',
+    '{1..10..3}',
+    '{01..03}',
+    '{a..e}/*.md',
+    '{src,test}/**/*.{ts,tsx}',
+  ])('matches the expansion glob performs: %s', (pattern) => {
+    expect(globBraceExpansions(pattern)).toBe(braceExpand(pattern).length);
+  });
+
+  it('saturates without enumerating a huge range or product', () => {
+    const started = Date.now();
+    expect(globBraceExpansions('{1..1000000000}/*')).toBe(
+      GLOB_PATTERN_MAX_EXPANSIONS + 1,
+    );
+    expect(globBraceExpansions('{a,b}'.repeat(40))).toBe(
+      GLOB_PATTERN_MAX_EXPANSIONS + 1,
+    );
+    expect(Date.now() - started).toBeLessThan(100);
+  });
+
+  it('admits exactly the limit', () => {
+    expect(globBraceExpansions('{a,b}'.repeat(12) + '/*')).toBe(4096);
+    expect(globBraceExpansions('{a,b}'.repeat(13) + '/*')).toBe(
+      GLOB_PATTERN_MAX_EXPANSIONS + 1,
+    );
+  });
+});
