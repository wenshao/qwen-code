+    'local-user',
+    undefined,
+    'prompt-live',
+    'Running prompt',
+  );
+});
+
+it('adopts the record id of a settled sender-local block', async () => {
+  connection.sessionId = 'session-1';
+  transcript.blocks = [userBlock('local-user', 1)];
+  navigation.locations.set('record-9', {
