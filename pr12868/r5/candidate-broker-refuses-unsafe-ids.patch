+    /**
+     * Text the worker admits on its provider envelope: printable and safe to
+     * use as a file name. The Broker releases every Runtime Session through
+     * that envelope, so an id the worker refuses must not be acquired either.
+     */
+    static String requirePathSafe(String value, String name) {
+        if (value.equals(".") || value.contains("..")
+                || value.indexOf('/') >= 0 || value.indexOf('\\') >= 0
+                || value.chars().anyMatch(unit -> unit <= 0x1f
+                        || unit >= 0x7f && unit <= 0x9f
+                        || Character.isSurrogate((char) unit))) {
+            throw new IllegalArgumentException(name
+                    + " must be printable and path-safe");
+        }
+        return value;
+    }
+
