+const PROVIDER_REASON_LIMIT = 4096;
+const PROVIDER_REASON_OMISSION = ' … [reason truncated]';
+
+/**
+ * The Broker forwards a reason only when it fits its bound and holds no NUL;
+ * otherwise it drops the code together with the text. A reason that echoes
+ * caller input can exceed the bound, so bound it here and keep the code.
+ */
+function providerReason(error: unknown): string {
+  const text =
+    error instanceof Error && error.message
+      ? error.message
+      : 'Managed Runtime provider operation failed.';
+  const clean = text.replaceAll('\0', '\uFFFD');
+  if (clean.length <= PROVIDER_REASON_LIMIT) return clean;
+  let end = PROVIDER_REASON_LIMIT - PROVIDER_REASON_OMISSION.length;
+  const last = clean.charCodeAt(end - 1);
+  // Never split a surrogate pair.
+  if (last >= 0xd800 && last <= 0xdbff) end--;
+  return clean.slice(0, end) + PROVIDER_REASON_OMISSION;
+}
