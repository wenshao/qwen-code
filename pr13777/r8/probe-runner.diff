+async function probeRename(
+  base: string,
+  tenantId: string,
+  sessionId: string,
+  port: number,
+  title: string,
+  revision: number,
+  phase: string,
+): Promise<void> {
+  const started = Date.now();
+  const filter = `tenant_id=${sqlString(tenantId)} AND session_id=${sqlString(sessionId)}`;
+  let status = 0;
+  let body = '';
+  let delivery = '';
+  let journal = '';
+  let publicTitle: unknown;
+  try {
+    const response = await fetch(`${base}/v1/agents/sessions/${sessionId}`, {
+      method: 'PATCH',
+      headers: {
+        'content-type': 'application/json',
+        'idempotency-key': `probe-rename-${revision}`,
+        ...tenantHeaders(tenantId),
+      },
+      body: JSON.stringify({ title }),
+    });
+    status = response.status;
+    body = (await response.text()).slice(0, 400);
+    while (Date.now() - started < 60_000) {
+      delivery = runMysql(
+        port,
+        `SELECT revision, delivery_state, attempt_count FROM qwen_managed_agent.managed_session_rename_delivery WHERE ${filter}`,
+      );
+      journal = runMysql(
+        port,
+        `SELECT COUNT(*) FROM qwen_managed_agent.qwen_managed_session_journal_tx WHERE ${filter} AND command_id=${sqlString(`hosted-title:${revision}`)}`,
+      );
+      const current = await fetchJson<{ metadata?: Record<string, unknown> }>(
+        `${base}/v1/agents/sessions/${sessionId}`,
+        { headers: tenantHeaders(tenantId) },
+      );
+      publicTitle = current.metadata?.['title'];
+      if (
+        delivery.split('\t')[1] === 'COMPLETED' &&
+        journal === '1' &&
+        publicTitle === title
+      )
+        break;
+      await new Promise((resolve) => setTimeout(resolve, 500));
+    }
+  } catch (error) {
+    body += ` ERROR ${String(error)}`;
+  }
+  const result = { phase, revision, title, status, body, delivery, journalTitleTx: journal, publicTitle, ms: Date.now() - started };
+  console.log(`PROBE rename ${JSON.stringify(result)}`);
+  if (process.env['PROBE_DUMP_DIR']) {
+    mkdirSync(process.env['PROBE_DUMP_DIR'], { recursive: true });
+    writeFileSync(
+      path.join(process.env['PROBE_DUMP_DIR'], `rename-${revision}.json`),
+      JSON.stringify(result, null, 2),
+    );
+  }
+}
+
+function probeState(port: number, label: string): void {
+  const file = existsSync(inflightSideEffect)
+    ? readFileSync(inflightSideEffect, 'utf8')
+    : null;
+  const q = (sql: string) => {
+    try {
+      return runMysql(port, sql).replace(/\n/g, ' | ');
+    } catch (error) {
+      return `ERR ${String(error).slice(0, 120)}`;
+    }
   };
+  const second = existsSync(probeSecondFile)
+    ? readFileSync(probeSecondFile, 'utf8')
+    : null;
+  console.log(
+    `PROBE state ${label} file=${file === null ? 'absent' : `${file.length}B exact=${file === inflightSideEffectContent}`} second=${second === null ? 'absent' : `exact=${second === probeSecondContent}`} executions=[${q('SELECT execution_state, dispatch_generation FROM qwen_managed_agent.qwen_tool_execution')}] actions=[${q("SELECT action_id, state, JSON_EXTRACT(options_json, '$.v') FROM qwen_managed_agent.managed_agent_action")}] turns=[${q('SELECT turn_id, status, error_code FROM qwen_managed_agent.managed_agent_turn ORDER BY created_at')}] hosted=[${q("SELECT kind, byte_length FROM qwen_managed_agent.qwen_managed_session_resource WHERE kind LIKE 'hosted-%' ORDER BY created_at")}]`,
+  );
 }
 
+function probeToolMessages(label: string): void {
+  const requests = fake?.requests ?? [];
+  const last = requests[requests.length - 1];
+  const messages = (last?.body?.messages ?? []) as Array<Record<string, unknown>>;
+  const tools = messages
+    .filter((message) => message.role === 'tool')
+    .map((message) =>
+      (typeof message.content === 'string' ? message.content : JSON.stringify(message.content)).slice(0, 200),
+    );
+  console.log(`PROBE tool messages ${label} requests=${requests.length} tools=${JSON.stringify(tools)}`);
+}
+
+function probeAutoAllow(
+  base: string,
+  tenantId: string,
+  sessionId: string,
+  port: number,
+  label: string,
+  skip: string[] = [],
+): () => Promise<void> {
+  let stopped = false;
+  const seen = new Set(skip);
+  const loop = (async () => {
+    while (!stopped) {
+      try {
+        const page = await fetchJson<PublicList<Record<string, unknown>>>(
+          `${base}/v1/agents/sessions/${sessionId}/actions?limit=100`,
+          { headers: tenantHeaders(tenantId) },
+        );
+        for (const action of page.data) {
+          const id = String(action.id);
+          if (action.state !== 'requested' || seen.has(id)) continue;
+          seen.add(id);
+          const options = JSON.parse(
+            runMysql(
+              port,
+              `SELECT options_json FROM qwen_managed_agent.managed_agent_action WHERE action_id=${sqlString(id)}`,
+            ) || '{}',
+          );
+          const response = await fetch(
+            `${base}/v1/agents/sessions/${sessionId}/actions/${id}/responses`,
+            {
+              method: 'POST',
+              headers: {
+                'content-type': 'application/json',
+                'idempotency-key': `probe-auto-${id}`,
+                ...tenantHeaders(tenantId),
+              },
+              body: JSON.stringify({
+                kind: 'permission',
+                input_revision: 1,
+                policy_revision: options.policyRevision,
+                option_id: 'allow',
+              }),
+            },
+          );
+          console.log(
+            `PROBE auto-allow ${label} ${id} call=${options.functionCallId} v=${options.v} plan=${!!options.continuationRef} -> ${response.status}`,
+          );
+        }
+      } catch (error) {
+        console.log(`PROBE auto-allow ${label} error ${String(error).slice(0, 200)}`);
+      }
+      await new Promise((resolve) => setTimeout(resolve, 500));
+    }
+  })();
+  return async () => {
+    stopped = true;
+    await loop;
+  };
+}
