+      'content-type': 'application/json',
+      'idempotency-key': `probe-next-${label}-${sessionId}`,
+      ...tenantHeaders(tenantId),
+    },
+    body: JSON.stringify({
+      type: 'agent.session.input.message',
+      input: [{ type: 'text', text: `${reliefMarker}. Reply exactly ${reliefResponse}. Use no tools.` }],
+    }),
+  });
+  console.log(`PROBE ${label} next input -> ${response.status}`);
+  const done = await waitForTerminal(base, tenantId, sessionId, after, child, 90_000);
+  const text = done.events
+    .filter((event) => event.type === 'item.output_text.delta')
+    .map(eventText)
+    .join('');
+  console.log(
+    `PROBE ${label} next terminal ${JSON.stringify(done.events.filter((event) => event.terminal).map((event) => event.type))} text=${JSON.stringify(text)} reliefRequests=${(fake?.requests ?? []).filter((request) => JSON.stringify(request.body.messages).includes(reliefMarker)).length}`,
+  );
+}
