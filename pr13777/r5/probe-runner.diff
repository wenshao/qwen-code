+async function probeRename(
+  base: string,
+  tenantId: string,
+  sessionId: string,
+  port: number,
+  title: string,
+  revision: number,
+  phase: string,
+): Promise<void> {
+  const started = Date.now();
+  const filter = `tenant_id=${sqlString(tenantId)} AND session_id=${sqlString(sessionId)}`;
+  let status = 0;
+  let body = '';
+  let delivery = '';
+  let journal = '';
+  let publicTitle: unknown;
+  try {
+    const response = await fetch(`${base}/v1/agents/sessions/${sessionId}`, {
+      method: 'PATCH',
+      headers: {
+        'content-type': 'application/json',
+        'idempotency-key': `probe-rename-${revision}`,
+        ...tenantHeaders(tenantId),
+      },
+      body: JSON.stringify({ title }),
+    });
+    status = response.status;
+    body = (await response.text()).slice(0, 400);
+    while (Date.now() - started < 60_000) {
+      delivery = runMysql(
+        port,
+        `SELECT revision, delivery_state, attempt_count FROM qwen_managed_agent.managed_session_rename_delivery WHERE ${filter}`,
+      );
+      journal = runMysql(
+        port,
+        `SELECT COUNT(*) FROM qwen_managed_agent.qwen_managed_session_journal_tx WHERE ${filter} AND command_id=${sqlString(`hosted-title:${revision}`)}`,
+      );
+      const current = await fetchJson<{ metadata?: Record<string, unknown> }>(
+        `${base}/v1/agents/sessions/${sessionId}`,
+        { headers: tenantHeaders(tenantId) },
+      );
+      publicTitle = current.metadata?.['title'];
+      if (
+        delivery.split('\t')[1] === 'COMPLETED' &&
+        journal === '1' &&
+        publicTitle === title
+      )
+        break;
+      await new Promise((resolve) => setTimeout(resolve, 500));
+    }
+  } catch (error) {
+    body += ` ERROR ${String(error)}`;
+  }
+  const result = { phase, revision, title, status, body, delivery, journalTitleTx: journal, publicTitle, ms: Date.now() - started };
+  console.log(`PROBE rename ${JSON.stringify(result)}`);
+  if (process.env['PROBE_DUMP_DIR']) {
+    mkdirSync(process.env['PROBE_DUMP_DIR'], { recursive: true });
+    writeFileSync(
+      path.join(process.env['PROBE_DUMP_DIR'], `rename-${revision}.json`),
+      JSON.stringify(result, null, 2),
+    );
+  }
+}
