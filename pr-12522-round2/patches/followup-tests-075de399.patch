     @Test
+    void closesTheConnectionOnTheDeadlineAndOnCallerCancel() throws Exception {
+        for (boolean callerCancels : new boolean[] {false, true}) {
+            java.util.concurrent.CountDownLatch closed =
+                    new java.util.concurrent.CountDownLatch(1);
+            HttpServer drip = HttpServer.create(
+                    new InetSocketAddress("127.0.0.1", 0), 0);
+            drip.setExecutor(java.util.concurrent.Executors
+                    .newCachedThreadPool());
+            drip.createContext("/", exchange -> {
+                exchange.getRequestBody().readAllBytes();
+                exchange.getResponseHeaders().set("Cache-Control", "no-store");
+                exchange.getResponseHeaders().set("Content-Type",
+                        "application/json");
+                exchange.sendResponseHeaders(200, 1 << 20);
+                java.io.OutputStream out = exchange.getResponseBody();
+                try {
+                    for (int tick = 0; tick < 200; tick++) {
+                        out.write(' ');
+                        out.flush();
+                        Thread.sleep(25);
+                    }
+                } catch (IOException gone) {
+                    closed.countDown();
+                } catch (InterruptedException interrupted) {
+                    Thread.currentThread().interrupt();
+                }
+            });
+            drip.start();
+            try {
+                HttpRuntimeTransport transport = new HttpRuntimeTransport(
+                        HttpClient.newBuilder()
+                                .version(HttpClient.Version.HTTP_1_1).build(),
+                        Duration.ofMillis(callerCancels ? 10_000 : 300));
+                java.util.concurrent.CompletableFuture<RuntimeAttestation>
+                        pending = attestAt(transport, drip).toCompletableFuture();
+                if (callerCancels) {
+                    Thread.sleep(200);
+                    pending.cancel(true);
+                }
+
+                assertTrue(closed.await(2, TimeUnit.SECONDS),
+                        callerCancels ? "caller cancel" : "deadline");
+            } finally {
+                drip.stop(0);
+            }
+        }
+    }
+
+    private java.util.concurrent.CompletionStage<RuntimeAttestation> attestAt(
+            HttpRuntimeTransport transport, HttpServer target) {
+        HttpServer saved = server;
+        server = target;
+        try {
+            HttpRuntimeTransport savedTransport = this.transport;
+            this.transport = transport;
+            try {
+                return attest();
+            } finally {
+                this.transport = savedTransport;
+            }
+        } finally {
+            server = saved;
+        }
+    }
