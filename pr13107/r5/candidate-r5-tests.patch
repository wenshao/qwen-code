+    // Call IDs restart per Turn, so the later Turn's call must not win.
+    const messages = [
+      toolGroup('turn-2', 'call-1'),
+      toolGroup('turn-3', 'call-1'),
+    ];
+    expect(findManagedApprovalTool(messages, action)?.callId).toBe(
