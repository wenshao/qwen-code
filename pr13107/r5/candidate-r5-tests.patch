+    const itemRows = managedEventsToMessages(
+      ['turn-2', 'turn-3'].map((turnId, index) => ({
+        id: 10 + index,
+        at: 10 + index,
+        type: 'tool_started' as const,
+        sessionId: 's1',
+        turnId,
+        data: {
