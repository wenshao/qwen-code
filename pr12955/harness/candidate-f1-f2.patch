From 3f80893d9dc6b94216efb0788fb3eb71e186db64 Mon Sep 17 00:00:00 2001
From: probe <probe@example.invalid>
Date: Tue, 29 Sep 2026 02:42:43 +0800
Subject: [PATCH 2/2] candidate test: pin the default-off Workspace file
 admission with an otherwise admissible Workspace

---
 .../ManagedWorkspaceFilesOptInTest.java       | 101 ++++++++++++++++++
 1 file changed, 101 insertions(+)
 create mode 100644 packages/sdk-java/managed-agent-server/src/test/java/com/alibaba/qwen/code/managedagent/ManagedWorkspaceFilesOptInTest.java

diff --git a/packages/sdk-java/managed-agent-server/src/test/java/com/alibaba/qwen/code/managedagent/ManagedWorkspaceFilesOptInTest.java b/packages/sdk-java/managed-agent-server/src/test/java/com/alibaba/qwen/code/managedagent/ManagedWorkspaceFilesOptInTest.java
new file mode 100644
index 0000000000..229d531e0c
--- /dev/null
+++ b/packages/sdk-java/managed-agent-server/src/test/java/com/alibaba/qwen/code/managedagent/ManagedWorkspaceFilesOptInTest.java
@@ -0,0 +1,101 @@
+package com.alibaba.qwen.code.managedagent;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import com.alibaba.qwen.code.managedagent.api.AuthenticatedTenantActor;
+import com.alibaba.qwen.code.managedagent.api.TenantContextFilter;
+import com.alibaba.qwen.code.runtimebroker.WorkspaceExecutionProfile;
+import java.nio.charset.StandardCharsets;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.http.MediaType;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.test.web.servlet.MockMvc;
+
+// The Workspace is otherwise admissible (fixed profile, mounted storage), so
+// only the default-off opt-in can refuse the initial input.
+@SpringBootTest(properties = {
+        "spring.datasource.url=jdbc:h2:mem:workspace-files-opt-in;MODE=MySQL;"
+                + "DB_CLOSE_DELAY=-1;DATABASE_TO_LOWER=TRUE",
+        "spring.datasource.driver-class-name=org.h2.Driver",
+        "spring.datasource.username=sa",
+        "spring.datasource.password=",
+        "qwen.managed-agent.harness.enabled=false",
+        "qwen.managed-agent.runtime-broker.workspace-mounts[0].tenant-id=tenant-opt-in",
+        "qwen.managed-agent.runtime-broker.workspace-mounts[0].storage-id=storage-a",
+        "qwen.managed-agent.runtime-broker.workspace-mounts[0].root=/tmp"
+})
+@AutoConfigureMockMvc
+class ManagedWorkspaceFilesOptInTest {
+    private static final String TENANT = "tenant-opt-in";
+
+    @Autowired
+    private MockMvc mvc;
+
+    @Autowired
+    private JdbcTemplate jdbc;
+
+    @Test
+    void refusesInitialInputUntilTheDeploymentOptsIn() throws Exception {
+        jdbc.update("INSERT INTO managed_workspace_registry (tenant_id,"
+                        + " workspace_id, workspace_generation, storage_id,"
+                        + " display_name, config_ref, policy_ref, state)"
+                        + " VALUES (?, 'ws-a', 1, 'storage-a', 'A', ?, ?, 'ACTIVE')",
+                TENANT, WorkspaceExecutionProfile.CONFIG_REF,
+                WorkspaceExecutionProfile.POLICY_REF);
+        jdbc.update("INSERT INTO managed_workspace_access (tenant_id,"
+                        + " workspace_id, actor_id, can_read, can_create)"
+                        + " VALUES (?, 'ws-a', ?, TRUE, TRUE)", TENANT,
+                "actor-a".getBytes(StandardCharsets.UTF_8));
+        mvc.perform(post("/v1/agents/sessions")
+                        .header(TenantContextFilter.HEADER, TENANT)
+                        .header("Idempotency-Key", "public-input")
+                        .principal(actor())
+                        .contentType(MediaType.APPLICATION_JSON)
+                        .content("""
+                                {"agent_id":"qwen-code",
+                                 "input":[{"type":"input_text","text":"go"}],
+                                 "workspace":{"workspace_id":"ws-a"}}
+                                """))
+                .andExpect(status().isConflict())
+                .andExpect(jsonPath("$.error.code").value("workspace_unavailable"));
+        mvc.perform(post("/api/agent/web-shell/v1/sessions/create")
+                        .header(TenantContextFilter.HEADER, TENANT)
+                        .principal(actor())
+                        .contentType(MediaType.APPLICATION_JSON)
+                        .content("""
+                                {"idempotencyKey":"web-input",
+                                 "agentId":"qwen-code",
+                                 "input":[{"type":"input_text","text":"go"}],
+                                 "workspace":{"workspaceId":"ws-a"}}
+                                """))
+                .andExpect(status().isConflict())
+                .andExpect(jsonPath("$.error.code").value("workspace_unavailable"));
+        assertThat(jdbc.queryForObject("SELECT COUNT(*) FROM managed_agent_session"
+                + " WHERE tenant_id = ?", Integer.class, TENANT)).isZero();
+    }
+
+    private static AuthenticatedTenantActor actor() {
+        return new AuthenticatedTenantActor() {
+            @Override
+            public String getName() {
+                return "actor-a";
+            }
+
+            @Override
+            public String tenantId() {
+                return TENANT;
+            }
+
+            @Override
+            public String actorId() {
+                return "actor-a";
+            }
+        };
+    }
+}
-- 
